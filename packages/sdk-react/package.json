{
  "name": "@branch-agent/sdk-react",
  "version": "0.0.0",
  "private": true,
  "description": "React hooks for a Branch Agent running on this computer, around the plain client in packages/sdk",
  "type": "module",
  "license": "MIT",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./hooks": {
      "types": "./index.d.ts",
      "default": "./hooks.mjs"
    }
  },
  "files": ["index.mjs", "hooks.mjs", "index.d.ts", "README.md"],
  "peerDependencies": {
    "@branch-agent/sdk": "0.0.0",
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=25.4.0"
  }
}
