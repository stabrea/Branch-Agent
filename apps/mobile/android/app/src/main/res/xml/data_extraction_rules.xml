<?xml version="1.0" encoding="utf-8"?>
<!-- The sealed key is only useful on this phone, so nothing is copied to a backup or a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
