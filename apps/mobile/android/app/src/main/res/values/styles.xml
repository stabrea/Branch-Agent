<?xml version="1.0" encoding="utf-8"?>
<!-- Every colour here is a branch_* colour, made from public/theme-catalogue.js by
     apps/mobile/scripts/native-files.mjs (values/ for light, values-night/ for dark). -->
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/branch_ground</item>
        <item name="colorPrimaryDark">@color/branch_ground</item>
        <item name="colorAccent">@color/branch_accent</item>
        <item name="android:windowBackground">@color/branch_ground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/branch_ground</item>
        <item name="colorAccent">@color/branch_accent</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/branch_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
