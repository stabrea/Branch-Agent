{
  "budgetSeconds": 220,
  "unknownTestSeconds": 30,
  "always": [
    "tests/leak-guard.test.mjs"
  ],
  "ignored": [
    "docs/**",
    "**/*.md",
    ".github/ISSUE_TEMPLATE/**",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
