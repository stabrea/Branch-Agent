{
  "manifest_version": 3,
  "name": "Send to Branch",
  "version": "1.1.0",
  "description": "Send the page you are looking at to your own Branch Agent as a task, or talk to it in the side panel.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Send to Branch",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
