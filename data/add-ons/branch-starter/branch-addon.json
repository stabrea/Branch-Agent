{
  "format": "branch-addon",
  "apiVersion": 1,
  "id": "branch-starter",
  "name": "Branch starter",
  "version": "1.0.0",
  "description": "An example add-on that comes with Branch: a word counter, a search source for Branch's own words, a skill, and a filter that takes out card numbers.",
  "author": "Branch Agent",
  "skills": [
    "branch-words.md"
  ],
  "plugin": "branch-starter.mjs",
  "permissions": [
    "text.read"
  ],
  "hosts": [],
  "filters": [
    {
      "id": "starter-card-numbers",
      "name": "Take out card numbers",
      "stage": "both",
      "match": "\\b\\d(?:[ -]?\\d){12,15}\\b",
      "pattern": true,
      "action": "redact",
      "text": "[card number taken out]"
    }
  ],
  "files": {
